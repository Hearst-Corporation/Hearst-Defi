{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/page.tsx",
    "src/app/**/layout.tsx",
    "src/app/**/template.tsx",
    "src/app/**/loading.tsx",
    "src/app/**/error.tsx",
    "src/app/**/not-found.tsx",
    "src/app/**/global-error.tsx",
    "src/app/**/default.tsx",
    "src/app/**/route.ts",
    "src/app/**/{sitemap,robots,manifest}.ts",
    "src/app/**/{opengraph-image,twitter-image,icon,apple-icon}.tsx",
    "next.config.ts",
    "src/proxy.ts",
    "instrumentation.ts",
    "instrumentation-client.ts",
    "sentry.server.config.ts",
    "sentry.edge.config.ts",
    "prisma/seed.ts",
    "prisma/backfill.ts",
    "src/lib/inngest/functions/**/*.ts",
    "scripts/**/*.{mjs,js,ts}",
    "src/**/*.{test,spec}.{ts,tsx}",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "**/*.stories.tsx"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "**/*.d.ts",
    "**/timeseries*.tsx",
    "src/lib/empty-module.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [],
  "ignoreBinaries": ["foundry", "forge", "anvil", "cast"]
}
