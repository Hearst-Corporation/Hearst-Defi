#!/bin/sh
# Pre-commit — MINIMAL. Front editing is unbraked (per Adrien 2026-06-20):
# no DS token-drift, no DS layout audit, no component-index gate. Only the
# secret-leak guard remains (non-negotiable safety).
#
# To restore a gate, re-add its line here (e.g. `pnpm ds:token-drift || exit 1`).

# Secret-leak guard — scans ONLY the staged diff (fast), masks any hit, never
# prints the value. Blocks the commit on a positive match. Bypass once (e.g.
# confirmed false positive) with `git commit --no-verify`.
bash scripts/secrets-scan.sh --staged || exit 1

# Protected docs — mandatory references; must exist, never delete (cf. DO_NOT_TOUCH.md).
node scripts/protected-docs-check.mjs || exit 1

# CSS cross-file dup guard — the "doublon" root cause: UNE classe de base stylée
# dans 2 feuilles (générations qui se superposent et se contredisent). Ratchet
# vs scripts/css-dupe-baseline.json : ne bloque QUE les NOUVEAUX doublons, jamais
# la dette existante. Ne tourne que si un .css est stagé. Bypass: --no-verify ;
# accepter un nouveau doublon volontaire: `pnpm quality:css:update`.
if git diff --cached --name-only --diff-filter=ACM | grep -q '\.css$'; then
  node scripts/css-dupe-check.mjs || exit 1
fi
