#!/bin/sh
# Pre-commit — MINIMAL. Front + DS editing FULLY unbraked (per Adrien 2026-06-26):
# every DS/quality gate removed — no token-drift, no layout audit, no
# component-index, no protected-docs, no CSS cross-file dup guard. Edit tokens,
# CSS and components freely. ONLY the secret-leak guard remains (non-negotiable
# safety — never commit a key, cf. CLAUDE.md).
#
# To restore a gate, re-add its line here (e.g. `node scripts/css-dupe-check.mjs || exit 1`).

# Secret-leak guard — scans ONLY the staged diff (fast), masks any hit, never
# prints the value. Blocks the commit on a positive match. Bypass once (e.g.
# confirmed false positive) with `git commit --no-verify`.
bash scripts/secrets-scan.sh --staged || exit 1

# Gate rapide doctrine (governance, refonte 2026-07-25) — oxlint type-aware, ~3 s
# sur tout src. --quiet : n'affiche et ne bloque QUE les erreurs ; v1 = tout en
# warn (stock 519 warnings, 0 règle promue) — la promotion en erreurs se fait
# par ratchet en mission 1B. Ne réintroduit aucune gate DS lourde (décision
# 2026-06-26 intacte) : total du hook < 5 s. Bypass : --no-verify.
pnpm --silent exec oxlint --type-aware --quiet src || exit 1
