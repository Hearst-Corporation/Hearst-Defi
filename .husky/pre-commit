#!/bin/sh
# Keeps the component index fresh on every commit. Fast (<2s).
#
# NOTE: the jscpd duplication ratchet was removed (per Adrien) — it blocked
# legitimate shared patterns (e.g. the two-round agentic SDK calls in
# chat-agent). Re-add `node scripts/quality-gate.mjs dup` below to restore it.

node scripts/component-index.mjs --stage || exit 1

# DS token drift — fast guard (reads 3 CSS files), blocks brand/token regressions.
pnpm ds:token-drift || exit 1

# Secret-leak guard — scans ONLY the staged diff (fast), masks any hit, never
# prints the value. Blocks the commit on a positive match. Bypass once (e.g.
# confirmed false positive) with `git commit --no-verify`.
bash scripts/secrets-scan.sh --staged || exit 1
