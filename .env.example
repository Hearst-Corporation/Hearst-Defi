# =============================================================================
# REQUIRED
# =============================================================================

# Local dev: SQLite. Production: Postgres connection string.
# Path is resolved relative to prisma/schema.prisma (Prisma 5+ behaviour), so
# the file actually lives at prisma/dev.db on disk.
DATABASE_URL="file:./prisma/dev.db"

# Prisma provider switch (sqlite local / postgresql prod)
# Read at build time by scripts/prisma-provider.mjs to rewrite datasource in schema.prisma.
# Values: sqlite (default local) | postgresql (Vercel/prod)
PRISMA_PROVIDER=sqlite

# =============================================================================
# AUTH (database email/password) — admin bootstrap
# Authentication is email + password, backed by the DB (hc_session cookie).
# ADMIN_EMAILS: comma-separated emails seeded as role=admin by `pnpm db:seed`.
# ADMIN_INITIAL_PASSWORD: initial password applied to those admin accounts.
# The seed is idempotent and a no-op when either is blank.
# =============================================================================
ADMIN_EMAILS=""
ADMIN_INITIAL_PASSWORD=""

# Canonical public app URL — used to build password-reset links safely.
# Using x-forwarded-host as a fallback is attacker-controllable; set this to
# the deployed origin (e.g. https://connect.hearst.app) in all environments.
NEXT_PUBLIC_APP_URL=""

# DEV ONLY — auth bypass. Set DEV_AUTH_BYPASS="1" in local dev to skip login
# and reach protected routes directly as a seeded dev investor. DOUBLE-GATED:
# it has NO effect when NODE_ENV=production, so it can never leak to prod.
# Leave blank everywhere except local development.
DEV_AUTH_BYPASS=""
DEV_USER_EMAIL="dev@hearst.local"

# =============================================================================
# PAYMENT (Privy) — https://dashboard.privy.io
# Privy is NOT used for authentication. It powers the USDC subscription/payment
# flow only (wallet connect at deposit time). Optional everywhere — the app
# boots and authenticates without it. Fill to enable the wallet payment flow.
# =============================================================================
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# =============================================================================
# BLOCKCHAIN (Base Sepolia) — Phase 2+ smart contracts
# Defaults resolve from config/deployments.base-sepolia.json.
# =============================================================================
NEXT_PUBLIC_CHAIN_RPC_URL=https://sepolia.base.org

# Ethereum-MAINNET RPC, used ONLY to read the Chainlink BTC/USD oracle (the
# aggregator lives on mainnet — it cannot be read over the Base-Sepolia RPC
# above). Server-only, may embed an API key. When blank, the BTC loader skips
# the oracle and serves CoinGecko `live` (honest provenance either way).
CHAINLINK_RPC_URL=""

# Phase 2 contract addresses — optional overrides.
NEXT_PUBLIC_EVENT_LOGGER_ADDRESS=""
NEXT_PUBLIC_POR_REGISTRY_ADDRESS=""
NEXT_PUBLIC_EVENT_LOGGER_DEPLOY_BLOCK=
NEXT_PUBLIC_POR_REGISTRY_DEPLOY_BLOCK=

# Phase 3 vault address — required in production for invest/redeem flows.
NEXT_PUBLIC_HEARST_YIELD_VAULT_ADDRESS=""

# =============================================================================
# DYNAVAULT v2.1 (chantier de remplacement du contrat)
# Doc complète : docs/DYNAVAULT_V2_WIRING.md
# État des lieux : docs/CONTRACT_REPLACEMENT_CARTOGRAPHY_2026-07-15.md
# =============================================================================

# Adresse de PermissionedDynaVault v2.1 sur Base Sepolia.
#
# ⚠️ LE CONTRAT N'EST PAS ENCORE DÉPLOYÉ — toutes les adresses de la spec sont
# TBD. Cette var reste donc VIDE partout aujourd'hui, et c'est l'état attendu.
#
# À quoi elle sert : c'est LE sélecteur de mode de src/lib/chain/dynavault.ts.
#   vide / mal formée  → l'adaptateur retombe sur le vault legacy
#                        (NEXT_PUBLIC_HEARST_YIELD_VAULT_ADDRESS ci-dessus) et ne
#                        lit que le sous-ensemble commun (totalAssets, shares,
#                        convertToAssets, asset, paused). Tout le reste renvoie
#                        `unavailable` / `not_supported_by_legacy` — jamais une
#                        valeur fabriquée.
#   adresse 0x… valide → mode "v2" : toute la surface v2.1 devient lisible, et
#                        les valeurs concernées s'affichent en BLEU dans l'UI.
# Défaut : vide (mode legacy si l'adresse legacy est posée, sinon not_configured).
#
# NEXT_PUBLIC_* ⇒ inlinée dans le bundle client AU BUILD : après avoir posé cette
# valeur, il faut REBUILD, pas seulement redémarrer.
NEXT_PUBLIC_DYNAVAULT_ADDRESS=""

# Kill-switch du keeper (rebalance / payElectricity / reportMiningMetrics).
# "1" = les routes keeper peuvent signer. Toute autre valeur = elles refusent,
# fail-closed, sans jamais toucher la chaîne.
# Défaut : 0 (OFF). Le keeper est une action privilégiée qui déplace de la
# valeur — il ne s'allume que sur décision explicite (cf. ADR-018 : aucun agent
# ne détient de clé ; le keeper est un process opéré, pas une crew).
KEEPER_ENABLED=0

# Clé privée du wallet keeper. SERVER-ONLY — ne JAMAIS la préfixer NEXT_PUBLIC_,
# ne jamais la lire depuis un composant client. Sans elle, les routes keeper
# répondent "indisponible" même si KEEPER_ENABLED=1 (fail-closed).
# Défaut : vide. Utiliser une clé jetable tant qu'on est sur Base Sepolia.
# (DEPLOYER_PRIVATE_KEY reste dans .env.deploy, pour Foundry uniquement.)
KEEPER_PRIVATE_KEY=""

# =============================================================================
# TICKET MINIMUM APPLICATIF (USDC entiers — l'actif est USDC, 6 décimales)
# Résolution : src/lib/vaults/min-ticket.ts (source unique)
# =============================================================================

# MIN_TICKET_USDC est un OVERRIDE, pas une valeur : non posée, RIEN ne change.
# Le plancher par défaut reste alors celui déjà en place — le preset de classe
# côté validation (Classe A : 250000, Classe B : 1000000) et la colonne
# `VaultDeployment.minTicketUsdc` propre à chaque vault côté data. C'est
# pourquoi la var n'a PAS de défaut à 250000 : un défaut écraserait le minimum
# configuré d'un vault qui vaudrait autre chose.
#
# Valeur de chantier : 1 — décision Adrien, "pour l'instant". Elle est alignée
# sur le contrat legacy déployé, dont minDeposit() vaut réellement 1 USDC ;
# c'est le blocage à 250000 côté app qui empêchait le CTA d'investissement de
# produire le moindre dépôt.
#
# ⚠️ À REMETTRE À 250000 (ou à retirer la var) AVANT TOUT LP RÉEL. Ce minimum
# est APPLICATIF : ni le contrat legacy (au-delà de son minDeposit) ni la v2.1
# ne le portent — il est donc contournable en appelant le contrat en direct.
#
# Honorée dans TOUS les environnements, production incluse. Server-only (PAS de
# préfixe NEXT_PUBLIC_) : le formulaire d'investissement reçoit le minimum déjà
# résolu en prop depuis un Server Component.
# Valeur illisible ("abc", "0", négatif) ⇒ traitée comme absente : le plancher
# REMONTE au défaut produit, il ne descend jamais, et le serveur ne plante pas.
# Défaut : non posée (= aucun override).
MIN_TICKET_USDC=1

# DEPRECATED — ancien nom de MIN_TICKET_USDC, priorité INFÉRIEURE. Conservé
# uniquement parce qu'il est déjà provisionné (prod + .env.local). Attention :
# il était inerte en production ; il ne l'est PLUS (même règle que ci-dessus).
# env.ts émet un warning en production quand c'est lui qui fixe le plancher.
# À migrer vers MIN_TICKET_USDC (même valeur), puis supprimer.
# DEMO_MIN_TICKET_USDC=

# =============================================================================
# INVESTOR RELATIONS (optional — onboarding + deposit confirmed UI)
# All three required to show the IR contact card (no fabricated defaults).
# =============================================================================
NEXT_PUBLIC_IR_CONTACT_NAME=""
NEXT_PUBLIC_IR_CONTACT_EMAIL=""
NEXT_PUBLIC_IR_CONTACT_TITLE="Investor Relations"
NEXT_PUBLIC_CALENDLY_URL=""

# =============================================================================
# ADMIN / OPS — comma-separated Ethereum addresses
# =============================================================================
ADMIN_ADDRESSES=""

# DEPLOYER_PRIVATE_KEY — DO NOT put here. Use .env.deploy (Foundry scripts only, never the app server).
HEARST_PUBLISHER=""

# =============================================================================
# RATE LIMITING (Upstash Redis) — required for multi-instance deployments
# =============================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# =============================================================================
# OBSERVABILITY (Sentry) — https://sentry.io
# All optional — project boots without them (no-op fallback).
# =============================================================================
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# =============================================================================
# ANALYTICS (PostHog) — https://posthog.com
# =============================================================================
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# =============================================================================
# BACKGROUND JOBS (Inngest) — https://www.inngest.com
# Required in production to authenticate job requests to /api/inngest.
# =============================================================================
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# =============================================================================
# EMAIL / NOTIFICATIONS (Resend) — https://resend.com
# Transactional email for investor distribution notifications (and governance
# alerts once the dispatcher lands). Optional, but when UNSET the app SKIPS all
# email silently — investors are paid but never notified. env.ts logs a loud
# warning in production when this is missing.
# =============================================================================
RESEND_API_KEY=""

# =============================================================================
# LLM — OpenAI GPT-4.1 (ADR-011) — agents + cockpit chat
# Get your key at https://platform.openai.com — server-side only.
# =============================================================================
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1"
# Optional: Azure OpenAI / corporate proxy
# OPENAI_BASE_URL=""
# OPENAI_ORG_ID=""
# Optional fallback when primary model fails (e.g. "gpt-4o")
# OPENAI_FALLBACK_MODEL=""

# =============================================================================
# DEMO MODE — set to "1" to force deterministic fixtures on every request
# (no DB, no upstream APIs). Leave "0" in production; flip per-browser via the
# in-app toggle (cookie hearst-demo-mode=1, 24h TTL).
# =============================================================================
DEMO_MODE_DEFAULT=0

# =============================================================================
# DEMO PROVIDER — set to "1" to enable the demo provider (local/staging ONLY).
#   - Demo identity = test@hearst.local sees synthetic demo data on product
#     surfaces. Production is fail-closed: the provider is OFF even with the
#     flag set (see src/lib/demo/guard.ts).
#   - Demo invest flow performs NO wallet connection, NO chain write, and NO
#     DB write — it is purely a visual sandbox.
# =============================================================================
DEMO_PROVIDER_ENABLED=

# =============================================================================
# LLM PROVIDER SELECTOR — "openai" (default) or legacy override
# ADR-011: OpenAI GPT-4.1 is the single provider. This var is kept for
# backwards compat with env files that set it explicitly.
# =============================================================================
LLM_PROVIDER=openai

# =============================================================================
# MASTER AGENT (cockpit chat) — set to "1" to enable navigation + admin read tools
# Flag-gated per ADR-012. Off by default locally; use "1" in prod (.env.production.example).
# Rail chat chip: Agent (ON) vs Texte seul (OFF).
# =============================================================================
CHAT_MASTER_AGENT=0

# =============================================================================
# MINING — operational config
# =============================================================================
# Basis points of mining revenue allocated to the vault (e.g. 8500 = 85%)
MINING_REVENUE_SHARE_BPS=8500

# Vault publisher wallet — used by Inngest jobs to sign attestations.
# Use DEPLOYER_PRIVATE_KEY for Foundry deploys (.env.deploy, never here).
HEARST_PUBLISHER_PRIVATE_KEY=""

# =============================================================================
# CUSTODY (Fireblocks) — institutional custody layer
# Workspace: production. Vault account 86 "Hearst Connect".
#
# PEM key — two options (FIREBLOCKS_SECRET_KEY takes precedence):
#   FIREBLOCKS_SECRET_KEY      Inline PEM content. Required for Vercel/serverless
#                              (copy the full multi-line PEM value as an env var).
#   FIREBLOCKS_SECRET_KEY_PATH Absolute path to a local PEM file. Works in dev
#                              but cannot be used on Vercel — use the above instead.
# =============================================================================
FIREBLOCKS_API_KEY=""
FIREBLOCKS_BASE_URL="https://api.fireblocks.io"
FIREBLOCKS_SECRET_KEY=""
FIREBLOCKS_SECRET_KEY_PATH=""
FIREBLOCKS_VAULT_ACCOUNT_IDS=""

# =============================================================================
# IDENTITY VERIFICATION (Sumsub) — https://sumsub.com
# Required for investor KYC/AML onboarding. Replaces the retired Persona vendor.
# Server-only (never NEXT_PUBLIC_*). The UI is a native Cockpit form — there is
# NO Sumsub WebSDK / iframe / CDN asset. Investors upload a document; the verdict
# lands on /api/sumsub/webhook.
#
# SANDBOX vs PRODUCTION is selected by the app-token PREFIX, not by a separate
# URL: sandbox tokens carry `sbx:`, production tokens `prd:`. Both hit the same
# host (https://api.sumsub.com). Use a `sbx:` token here for sandbox testing.
# =============================================================================
# App token — routes sandbox vs prod by its prefix (sbx:… / prd:…).
SUMSUB_APP_TOKEN=""
# Secret key — signs every API request (X-App-Access-Sig HMAC-SHA256).
SUMSUB_SECRET_KEY=""
# Webhook HMAC secret — verifies inbound x-payload-digest. /api/sumsub/webhook
# fails CLOSED (401 on mismatch, 500 when unset) until this is provisioned, so an
# unverified event can never approve KYC. REQUIRED in production (env.ts throws).
SUMSUB_WEBHOOK_SECRET=""
# Verification level. Defaults to "id-only" (document-only, no selfie/liveness —
# matches the custom Cockpit form). Override only to match your Sumsub level name.
SUMSUB_LEVEL_NAME="id-only"

# =============================================================================
# WEBHOOK / ATTESTATION / TOTP SECRETS (P1 — surfaced by `pnpm preflight`)
# Each missing value lets the app boot, but the named feature fails CLOSED
# (disabled safely, never a crash) until the secret is provisioned in prod.
# =============================================================================
# DocuSign Connect webhook HMAC secret. /api/docusign/webhook rejects every
# event until this is set (fails closed).
DOCUSIGN_WEBHOOK_SECRET=""
# Typeform webhook secret (onboarding qualification questionnaire). Set the same
# value in the Typeform webhook config. /api/typeform/webhook fails closed (503)
# until this is set, and rejects mismatched signatures (401).
TYPEFORM_WEBHOOK_SECRET=""
# Comma-separated allowlist of attestation signer addresses (0x…). Attestation
# verification returns `no_allowlist_configured` until set.
ATTESTATION_ALLOWED_SIGNERS=""
# AES-256 key (hex) encrypting admin TOTP secrets at rest. Admin TOTP login
# fails until set. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_TOTP_KEY=""

# =============================================================================
# CRM (HubSpot) — contact sync + notes from memory distillation
# Private App token from HubSpot Settings → Integrations → Private Apps.
# Required scopes: crm.objects.contacts.write, crm.objects.contacts.read,
#                  crm.objects.notes.write
# HUBSPOT_WEBHOOK_SECRET: client secret from HubSpot App settings (for
# inbound webhook signature validation). /api/hubspot/webhook fails closed
# (503) until set. Bidirectional sync only (contact.propertyChange events).
# =============================================================================
HUBSPOT_API_KEY=""
HUBSPOT_WEBHOOK_SECRET=""

# =============================================================================
# OUTREACH — cold prospects + newsletters (email-outreach agent)
# OUTREACH_FROM: dedicated sender with a real reply-to, e.g.
#   "Hearst Connect <contact@hearst.app>". Verify the domain + enable open/click
#   tracking in Resend. Falls back to the transactional sender if unset.
# RESEND_WEBHOOK_SECRET: Svix secret from the Resend webhook config. The
#   tracking receiver /api/resend/webhook fails closed (503) until it is set.
# NEXT_PUBLIC_TYPEFORM_URL: qualification form linked in every cold email CTA.
# =============================================================================
OUTREACH_FROM=""
RESEND_WEBHOOK_SECRET=""
NEXT_PUBLIC_TYPEFORM_URL="https://form.typeform.com/to/NXUw7yzJ"

# =============================================================================
# DATABASE (Supabase) — production Postgres
# Used when PRISMA_PROVIDER=postgresql. The shared vars point to the
# Supabase project used by all Hearst services (pjwyntugyswabgpavtyt).
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_SHARED_URL=""
NEXT_PUBLIC_SUPABASE_SHARED_ANON_KEY=""

# =============================================================================
# BLOCKCHAIN — legacy + additional addresses
# =============================================================================
NEXT_PUBLIC_USDC_ADDRESS_BASE_SEPOLIA="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
NEXT_PUBLIC_LEGACY_VAULT_ADDRESS=""
NEXT_PUBLIC_LEGACY_POSITION_ADDRESS=""

# =============================================================================
# OPTIONAL / FUTURE
# =============================================================================

# Document Vault — cross-origin allowlist for the hearst-docs-vault frontend.
# Comma-separated origins allowed to call /api/document-vault/* with credentials.
# NEVER use "*". Defaults to http://localhost:4210 in dev when unset.
DOCUMENT_VAULT_ALLOWED_ORIGINS=http://localhost:4210
