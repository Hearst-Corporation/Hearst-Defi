# ============================================================================
# Hearst Connect — PRODUCTION env template (placeholders only — NO real secrets)
# ----------------------------------------------------------------------------
# Copy real values into Vercel Project → Settings → Environment Variables
# (Production scope). Do NOT commit a filled version. `.env.local` stays for dev.
#
# Legend:  ✅ have it (reuse current)   🔴 BLOCKED by a hard gate   🟡 need prod value
#
# THREE HARD GATES before a real financial go-live (real investors / real money):
#   GATE 1 — Smart contract mainnet: blocked on Spearbit audit + remediation
#            (CLAUDE.md #8, ADR-006/ADR-010). No audited mainnet vault exists yet.
#   GATE 2 — KYC production: no persona_production_* key exists; must be created
#            + approved on the Persona dashboard (Production mode).
#   GATE 3 — Database: prod must be Postgres (Supabase), not SQLite.
# Until all three clear, only a TESTNET+SANDBOX "live preview" is deployable.
# ============================================================================

# ── Database — GATE 3 ────────────────────────────────────────────────────────
# 🔴 prod = Supabase Postgres. The build swaps the Prisma provider to postgresql
#    (scripts/prisma-provider.mjs) when DATABASE_URL is postgres(ql)://.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ── On-chain — GATE 1 (mainnet gated on audit) ───────────────────────────────
# 🔴 Switch to Base MAINNET only after the audit clears + an audited vault is
#    deployed. Until then this stays Base Sepolia (testnet) for the live preview.
NEXT_PUBLIC_CHAIN_RPC_URL="https://base-mainnet.g.alchemy.com/v2/YOUR_MAINNET_KEY"
NEXT_PUBLIC_HEARST_YIELD_VAULT_ADDRESS="0xAUDITED_MAINNET_VAULT_ADDRESS"
# Base mainnet USDC (canonical): 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDC_ADDRESS="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
# Phase 2 contracts (EventLogger / PoRRegistry) — mainnet addresses post-deploy
NEXT_PUBLIC_EVENT_LOGGER_ADDRESS="0xMAINNET_EVENT_LOGGER"
NEXT_PUBLIC_POR_REGISTRY_ADDRESS="0xMAINNET_POR_REGISTRY"
NEXT_PUBLIC_EVENT_LOGGER_DEPLOY_BLOCK="0"
NEXT_PUBLIC_POR_REGISTRY_DEPLOY_BLOCK="0"

# ── Wallet connect (Privy) — 🟡 add prod domain ──────────────────────────────
# ✅ App ID/Secret exist. In the Privy dashboard, add the prod origin
#    (https://connect.hearst.app) to Allowed origins + enable the mainnet chain.
NEXT_PUBLIC_PRIVY_APP_ID="cmpl...PROD_OR_SAME_APP"
PRIVY_APP_SECRET="privy_app_secret_..."

# ── KYC (Persona) — GATE 2 ───────────────────────────────────────────────────
# 🔴 Production key does not exist yet — create on app.withpersona.com (Production
#    mode, account approved by Persona). Sandbox key/template will NOT work here.
PERSONA_API_KEY="persona_production_REAL_UUID"
NEXT_PUBLIC_PERSONA_ENVIRONMENT="production"
NEXT_PUBLIC_PERSONA_TEMPLATE_ID="itmpl_PRODUCTION_TEMPLATE"
PERSONA_WEBHOOK_SECRET="wbhsec_PRODUCTION"

# ── LLM — 🟡 fix provider ────────────────────────────────────────────────────
# ⚠️ Must be "openai" (ADR-011). Dev currently has LLM_PROVIDER=hypercli (stale).
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-...PROD"          # ✅ reuse / rotate as needed
OPENAI_MODEL="gpt-4.1"
OPENAI_DEFAULT_MODEL="gpt-4.1"
CHAT_MASTER_AGENT="1"

# ── Dev/demo flags — MUST be off in prod ─────────────────────────────────────
# (Guard is fail-closed: demo provider never runs when NODE_ENV=production even
#  if set. Keep these unset/0 anyway for clarity.)
DEV_AUTH_BYPASS="0"
DEMO_PROVIDER_ENABLED="0"
DEMO_MODE_DEFAULT="0"

# ── P1 preflight warnings — set before go-live ───────────────────────────────
DOCUSIGN_WEBHOOK_SECRET="..."        # 🟡 else DocuSign webhook fails-closed
TYPEFORM_WEBHOOK_SECRET="..."        # 🟡 else Typeform onboarding webhook fails-closed
ATTESTATION_ALLOWED_SIGNERS="0x..."  # 🟡 else attestation verify = no_allowlist
AUTH_TOTP_KEY="..."                  # 🟡 else admin TOTP login fails

# ── Custody (Fireblocks) — read-only PoR ─────────────────────────────────────
# ✅ PROD workspace, vault account 86, basePath /v1. Secret key path on the host.
FIREBLOCKS_API_KEY="..."
FIREBLOCKS_SECRET_KEY_PATH="/secure/path/fireblocks_secret.key"
FIREBLOCKS_BASE_URL="https://api.fireblocks.io/v1"
FIREBLOCKS_VAULT_ACCOUNT_IDS="86"

# ── Email / jobs / cache / observability ─────────────────────────────────────
RESEND_API_KEY="re_..."              # ✅
INNGEST_SIGNING_KEY="signkey-prod-..." # ✅
INNGEST_EVENT_KEY="..."              # 🟡 create on Inngest dashboard
UPSTASH_REDIS_REST_URL="https://...upstash.io"   # ✅
UPSTASH_REDIS_REST_TOKEN="..."                   # ✅
SENTRY_DSN="https://...ingest.de.sentry.io/..."  # ✅ (error-only, prod-only)
NEXT_PUBLIC_SENTRY_DSN="https://...ingest.de.sentry.io/..."
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="adrien-debug"
SENTRY_PROJECT="javascript-nextjs-cm"

# ── Supabase (auth/data layer) ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://PROD.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ...PROD_ANON"

# ── Admin bootstrap ──────────────────────────────────────────────────────────
ADMIN_EMAILS="ops@hearstcorporation.io"
ADMIN_ADDRESSES="0x..."              # admin wallet allowlist
# ADMIN_INITIAL_PASSWORD — set once, rotate immediately after first login.

# ── Mining advisory (not on-chain) ───────────────────────────────────────────
MINING_REVENUE_SHARE_BPS="4000"
