{
  "name": "hearst-connect",
  "version": "0.1.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10.0.0"
  },
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "prepare": "git config core.hooksPath .husky || true",
    "sonar": "docker run --rm -v \"$(pwd)\":/usr/src -e SONAR_TOKEN sonarsource/sonar-scanner-cli",
    "gate:admin": "node scripts/admin-honesty-gate.mjs",
    "check": "pnpm gate:admin && pnpm typecheck && pnpm lint && pnpm quality && pnpm test",
    "quality": "node scripts/quality-gate.mjs all",
    "quality:dup": "node scripts/quality-gate.mjs dup",
    "quality:dead": "node scripts/quality-gate.mjs dead",
    "quality:update": "node scripts/quality-gate.mjs update",
    "quality:index": "node scripts/component-index.mjs",
    "quality:css": "node scripts/css-dupe-check.mjs --report",
    "quality:css:update": "node scripts/css-dupe-check.mjs --update",
    "quality:dup:report": "jscpd src --reporters html --output .jscpd-report && echo 'open .jscpd-report/html/index.html'",
    "quality:dead:report": "knip",
    "commit:check": "node scripts/staged-scope-check.mjs",
    "predev": "node scripts/free-port.mjs && node scripts/prisma-provider.mjs && prisma generate",
    "dev": "NODE_OPTIONS=--max-http-header-size=65536 next dev -p 4105",
    "build": "node scripts/prisma-provider.mjs && prisma generate && NODE_ENV=production next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-4105}",
    "preflight": "node scripts/preflight-prod.mjs",
    "lint": "eslint src",
    "lint:fast": "oxlint --type-aware src",
    "ds:layout": "node scripts/ds-layout-audit.mjs",
    "ds:classes": "bash scripts/ds-classes-audit.sh",
    "ds:token-drift": "node scripts/ds-token-drift.mjs",
    "ds:guard": "node scripts/ds-hardcode-guard.mjs",
    "ds:guard:warn": "node scripts/ds-hardcode-guard.mjs --warn",
    "ds:guard:convergence": "node scripts/ds-convergence-guard.mjs",
    "ds:guard:primitive": "node scripts/ds-primitive-guard.mjs",
    "ds:guard:chart-engine": "node scripts/ds-chart-engine-guard.mjs",
    "ds:guard:all": "node scripts/ds-hardcode-guard.mjs && node scripts/ds-convergence-guard.mjs && node scripts/ds-primitive-guard.mjs && node scripts/ds-chart-engine-guard.mjs",
    "qa:perf-network": "node scripts/perf/qa-network-guardrails.mjs",
    "validate:zandbank-demo": "node scripts/validate-zandbank-demo.mjs",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6106",
    "storybook:build": "storybook build -o storybook-static",
    "storybook:test": "test-storybook --url http://localhost:6106",
    "test-storybook": "test-storybook --url http://localhost:6106",
    "pretest": "node scripts/assert-prisma-provider-safe.mjs sqlite && PRISMA_PROVIDER=sqlite node scripts/prisma-provider.mjs && PRISMA_PROVIDER=sqlite prisma generate",
    "test:sqlite:isolated": "PRISMA_SQLITE_ISOLATED=1 pnpm test",
    "posttest": "node scripts/restore-prisma-provider.mjs",
    "test": "vitest run; __code=$?; node scripts/restore-prisma-provider.mjs; exit $__code",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "pilot:e2e": "tsx scripts/pilot-e2e.ts",
    "db:generate": "node scripts/prisma-provider.mjs && prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill": "tsx prisma/backfill.ts",
    "seed:test": "tsx scripts/seed-test-user.ts",
    "seed:document-vault-assets": "tsx scripts/seed-document-vault-assets.ts",
    "seed:test:admin": "tsx scripts/seed-test-admin.ts",
    "seed:investor-demo:reset": "tsx scripts/wipe-seeded-data.ts",
    "seed:zandbank-demo:local": "tsx scripts/seed-zandbank-demo-local.ts",
    "electron:compile": "tsc -p electron",
    "electron:dev": "concurrently --restart-tries 3 --restart-after 2000 -n next,electron -c blue,magenta \"pnpm dev\" \"wait-on http://localhost:4105 && pnpm electron:compile && cross-env ELECTRON_RUN_AS_NODE= electron .\"",
    "electron:start": "pnpm electron:compile && cross-env ELECTRON_RUN_AS_NODE= electron .",
    "electron:test": "pnpm electron:compile && cross-env ELECTRON_RUN_AS_NODE= playwright test --config=playwright.electron.config.ts",
    "electron:build": "pnpm electron:compile && electron-builder --publish never",
    "electron:publish": "pnpm electron:compile && electron-builder --publish always",
    "qa:bundle": "node scripts/perf/qa-bundle-budgets.mjs"
  },
  "build": {
    "appId": "com.hearst.connect.desktop",
    "productName": "Hearst Connect",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/argparse/**/*",
      "node_modules/debug/**/*",
      "node_modules/ms/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/graceful-fs/**/*",
      "node_modules/js-yaml/**/*",
      "node_modules/jsonfile/**/*",
      "node_modules/lazy-val/**/*",
      "node_modules/lodash.escaperegexp/**/*",
      "node_modules/lodash.isequal/**/*",
      "node_modules/sax/**/*",
      "node_modules/semver/**/*",
      "node_modules/tiny-typed-emitter/**/*",
      "node_modules/universalify/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/splash.html",
        "to": "splash.html"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/entitlements.mac.plist",
      "entitlementsInherit": "electron/entitlements.mac.plist",
      "notarize": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance"
    },
    "publish": {
      "provider": "github",
      "owner": "Hearst-Corporation",
      "repo": "Hearst-Defi",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@fireblocks/ts-sdk": "^19.0.0",
    "@headlessui/react": "^2.2.10",
    "@hearst/hub-sdk": "file:./hearst-hub-sdk-0.2.0.tgz",
    "@hearst/review-mode": "file:./hearst-review-mode-0.1.0.tgz",
    "@huggingface/inference": "^4.13.20",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@privy-io/react-auth": "^3.25.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "^10.53.1",
    "@upstash/redis": "^1.38.0",
    "@web3icons/react": "^4.1.17",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "gray-matter": "^4.0.3",
    "inngest": "^4.4.0",
    "input": "^1.0.1",
    "langsmith": "^0.8.0",
    "lucide-react": "^1.14.0",
    "next": "^16.2.6",
    "openai": "^6.38.0",
    "otpauth": "^9.5.1",
    "pg": "^8.21.0",
    "posthog-js": "^1.373.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "recharts": "^3.9.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "telegram": "^2.26.22",
    "viem": "^2.48.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-a11y": "10.5.3",
    "@storybook/addon-docs": "10.5.3",
    "@storybook/addon-mcp": "0.7.0",
    "@storybook/nextjs-vite": "10.5.3",
    "@storybook/test-runner": "^0.24.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.7.0",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-config-next": "^16.2.6",
    "jscpd": "^5.0.9",
    "knip": "^6.14.2",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "storybook": "10.5.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10"
  }
}
